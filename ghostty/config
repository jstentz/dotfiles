font-family = "Hack Nerd Font Mono"
font-size = 10
theme = "Catppuccin Mocha"
app-notifications = "no-clipboard-copy"
window-width = 120
window-height = 35
window-theme = auto
copy-on-select = clipboard
scrollback-limit = 50000
adjust-cell-height = 10%
